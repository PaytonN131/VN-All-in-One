<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#211D26"><Grid.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="#211D26"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate><Border CornerRadius="4" Background="#49445E" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="Ink" Color="#F5EAF0"/>
  <SolidColorBrush x:Key="Muted" Color="#C2AFBF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#453449"/><Setter Property="Foreground" Value="#F5EAF0"/><Setter Property="BorderBrush" Value="#70546D"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#DFD5FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F5EAF0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#39334F"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#62465F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F5EAF0"/><Setter Property="Background" Value="#352A3B"/><Setter Property="BorderBrush" Value="#70546D"/><Setter Property="MinHeight" Value="40"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="8"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3" Foreground="#C1B6E7" FontSize="19"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Margin="12,5,32,5" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#322737" BorderBrush="#56516C" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#D9ACC8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="28"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="#BA8DAA"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate><Ellipse x:Name="Dot" Fill="#F2D6E5" Stroke="#D1A2BC" StrokeThickness="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="#554253"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
   </Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#2C2532"/><Setter Property="BorderBrush" Value="#544151"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#C2AFBF"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>

  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F5EAF0"/><Setter Property="Background" Value="#352A3B"/><Setter Property="BorderBrush" Value="#806079"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="Haz clic y pulsa una tecla o combinación. Tab: siguiente. Esc: cancelar."/></Style>
 <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style x:Key="Help" TargetType="TextBlock"><Setter Property="Foreground" Value="#CCB9C8"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
 <Style x:Key="Subhead" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="#CCB9C8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Nav" Background="Transparent" CornerRadius="9" Padding="18,11" Margin="0,0,0,5"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#63465F"/><Setter Property="Foreground" Value="#FFF0F7"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="#D4A0BD"/><Setter TargetName="Nav" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F5EAF0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,14"/></Style></Grid.Resources> <Border Width="192" HorizontalAlignment="Left" Background="#2A222F" BorderBrush="#544151" BorderThickness="0,0,1,0"/>
 <TabControl x:Name="Sections" TabStripPlacement="Left" SelectedIndex="0" Background="Transparent" BorderThickness="0">
  <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TabPanel IsItemsHost="True" Margin="14,190,14,140" VerticalAlignment="Top" KeyboardNavigation.TabIndex="1"/><ScrollViewer x:Name="PanelScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,28,30,24"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ScrollViewer></Grid></ControlTemplate></TabControl.Template>
  <TabItem Header="01   Inicio"><StackPanel>
   <TextBlock Text="Tu novela, a tu gusto" Style="{StaticResource Title}"/>
   <TextBlock Text="Elige el juego una vez. Después puedes ajustar la imagen, conservar voces y guardar tus escenas favoritas desde el menú lateral." Style="{StaticResource Help}"/>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="1. Conecta la novela" Style="{StaticResource Subhead}"/>
    <TextBlock Text="Abre el juego en modo ventana o sin bordes. Selecciona su ventana aquí y pulsa Conectar juego." Style="{StaticResource Help}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Windows" AutomationProperties.Name="Ventana del juego"/><Button x:Name="Refresh" Grid.Column="1" Content="Actualizar" Margin="10,0,0,0"/></Grid>
    <TextBlock Text="Nombre del juego para organizar tus archivos" Style="{StaticResource Label}" Margin="0,14,0,8"/><TextBox x:Name="GameName" IsReadOnly="False" Cursor="IBeam" AutomationProperties.Name="Nombre del juego para carpetas" ToolTip="Se completa desde el título de la ventana. Puedes corregirlo para que quede solo el nombre del juego."/><Button x:Name="Start" Content="Conectar juego" HorizontalAlignment="Left" Margin="0,14,0,0" Background="#B88FA8" Foreground="#211B25" IsDefault="True"/>
    <TextBlock x:Name="Status" Text="Selecciona una ventana para empezar." TextWrapping="Wrap" Foreground="#E1C5D8" Margin="0,14,0,0"/>
   </StackPanel></Border>


  </StackPanel></TabItem>
  <TabItem Header="02   Imagen"><StackPanel>
   <TextBlock Text="Una imagen más tuya" Style="{StaticResource Title}"/><TextBlock Text="Empieza con un estilo y afina los controles. El botón + de la izquierda activa o desactiva el filtro sin cerrar el programa." Style="{StaticResource Help}"/>
   <Border Style="{StaticResource Card}"><StackPanel>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Estilo y detalle" Style="{StaticResource Subhead}"/><Button x:Name="Reset" Grid.Column="1" Content="Restablecer" Padding="12,7"/></Grid>
    <ComboBox x:Name="Preset" AutomationProperties.Name="Estilo visual" Margin="0,0,0,20"/>
    <TextBlock><Run Text="Nitidez   "/><Run x:Name="SharpValue" Foreground="#D9ACC8"/></TextBlock><Slider x:Name="Sharp" Minimum="0" Maximum="2" Value="0.7" SmallChange="0.05" LargeChange="0.2" AutomationProperties.Name="Nitidez" Margin="0,4,0,15"/>
    <TextBlock><Run Text="Brillo / oscuridad   "/><Run x:Name="BrightnessValue" Foreground="#D9ACC8"/></TextBlock><Slider x:Name="Brightness" Minimum="-0.35" Maximum="0.35" Value="0" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Brillo" Margin="0,4,0,15"/>
    <TextBlock><Run Text="Contraste   "/><Run x:Name="ContrastValue" Foreground="#D9ACC8"/></TextBlock><Slider x:Name="Contrast" Minimum="0.6" Maximum="1.5" Value="1" SmallChange="0.02" LargeChange="0.1" AutomationProperties.Name="Contraste" Margin="0,4,0,15"/>
    <TextBlock><Run Text="Saturación   "/><Run x:Name="SaturationValue" Foreground="#D9ACC8"/></TextBlock><Slider x:Name="Saturation" Minimum="0" Maximum="1.8" Value="1" SmallChange="0.02" LargeChange="0.1" AutomationProperties.Name="Saturación" Margin="0,4,0,15"/>
    <TextBlock><Run Text="Temperatura · frío / cálido   "/><Run x:Name="WarmthValue" Foreground="#D9ACC8"/></TextBlock><Slider x:Name="Warmth" Minimum="-0.2" Maximum="0.2" Value="0" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Temperatura" Margin="0,4,0,15"/>
    <TextBlock><Run Text="Gamma · medios tonos   "/><Run x:Name="GammaValue" Foreground="#D9ACC8"/></TextBlock><Slider x:Name="Gamma" Minimum="0.65" Maximum="1.5" Value="1" SmallChange="0.02" LargeChange="0.1" AutomationProperties.Name="Gamma" Margin="0,4,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Fluidez y rendimiento" Style="{StaticResource Subhead}"/><TextBlock Text="GPU Nativa conserva el detalle original. Si el movimiento va a saltos, prueba 60 FPS. Reducir la resolución puede aliviar la GPU." Style="{StaticResource Help}"/><ComboBox x:Name="CaptureQuality" AutomationProperties.Name="Método y resolución del filtro" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><TextBlock Text="Límite del filtro (FPS)" VerticalAlignment="Center" Margin="0,0,15,0"/><ComboBox x:Name="Fps" Width="100" AutomationProperties.Name="Límite de FPS"/></StackPanel></StackPanel></Border>
   <Expander Header="Diagnóstico" Foreground="#CCB9C8"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="CaptureMetrics" Text="Aún no hay métricas de captura." TextWrapping="Wrap"/><Button x:Name="Diagnostic" Content="Guardar diagnóstico" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander>
  </StackPanel></TabItem>
  <TabItem Header="03   Audio"><StackPanel>
   <TextBlock Text="Conserva esa voz" Style="{StaticResource Title}"/><TextBlock Text="Captura solo el audio de la novela seleccionada. No necesitas empezar a grabar antes de escuchar la frase." Style="{StaticResource Help}"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cómo funciona" Style="{StaticResource Subhead}"/><TextBlock Text="1. Activa el audio y elige cuántos segundos recordar.&#10;2. Vuelve al juego. Después de la frase, pulsa tu tecla de audio.&#10;3. Abre Editar clips, ajusta las marcas y guarda el tramo como MP3." Style="{StaticResource Help}" Margin="0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="AudioEnabled" IsChecked="True" Content="Recordar el audio reciente del juego" FontSize="16"/><TextBlock Text="Segundos que quieres conservar antes de pulsar la tecla" Style="{StaticResource Label}"/><ComboBox x:Name="AudioLength" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="Duración del clip en segundos"/><TextBlock x:Name="AudioShortcutHint" Text="Tecla de audio: . · Cámbiala en Teclas" Margin="0,16,0,16" Foreground="#E1BED4"/><WrapPanel><Button x:Name="AudioEdit" Content="Editar clips (0/5)" Margin="0,0,10,10"/><Button x:Name="AudioFolder" Content="Abrir carpeta" Margin="0,0,10,10"/><Button x:Name="AudioRename" Content="Renombrar MP3 guardado…" Margin="0,0,0,10"/></WrapPanel><TextBlock x:Name="AudioStatus" TextWrapping="Wrap" Foreground="#D8C1D2" Margin="0,16,0,0"/></StackPanel></Border>
   <TextBlock Text="Hay espacio para 5 clips pendientes en memoria, no es un límite de archivos guardados. Guarda o descarta uno para liberar un hueco. Lo anterior al tiempo elegido se descarta automáticamente. Cada MP3 se guarda en Archivos VN All in One / Grabaciones / Nombre del juego. Escribe su nombre en el editor y pulsa Guardar MP3: se guarda directamente. También puedes renombrarlo después." Style="{StaticResource Help}"/>
  </StackPanel></TabItem>
  <TabItem Header="04   Clips"><StackPanel>
   <TextBlock Text="Escenas para volver a ver" Style="{StaticResource Title}"/><TextBlock Text="Graba la novela con su audio y con el filtro que tengas al iniciar. Otras ventanas y la caja de Luna no se incluyen." Style="{StaticResource Help}"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Antes de grabar" Style="{StaticResource Subhead}"/><TextBlock Text="Espera a Captura lista después de conectar el juego. Inicia con tu tecla de clip y termina con la tecla de detener. También puedes usar el botón de abajo." Style="{StaticResource Help}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tamaño del clip" Style="{StaticResource Label}"/><ComboBox x:Name="SceneResolution" AutomationProperties.Name="Resolución de grabación"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fotogramas por segundo" Style="{StaticResource Label}"/><ComboBox x:Name="SceneFps" AutomationProperties.Name="Fotogramas por segundo del MP4"/></StackPanel></Grid><Button x:Name="SceneRecord" Content="Grabar MP4 con filtro" HorizontalAlignment="Left" Margin="0,20,0,0"/><TextBlock x:Name="SceneKeys" TextWrapping="Wrap" Foreground="#E1BED4" Margin="0,16,0,0"/><TextBlock x:Name="SceneStatus" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#D8C1D2"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Revisa y recorta" Style="{StaticResource Subhead}"/><TextBlock Text="Abre un MP4, busca el momento, marca inicio y final, escribe el nombre, revisa con ▶ y guarda el recorte. El original se conserva. Si no te gusta un clip, puedes enviarlo a la Papelera desde el editor." Style="{StaticResource Help}"/><WrapPanel><Button x:Name="SceneEdit" Content="Abrir editor de clip…" Margin="0,0,10,10"/><Button x:Name="VideoFolder" Content="Abrir carpeta" Margin="0,0,10,10"/><Button x:Name="SceneRename" Content="Renombrar MP4…" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border>
   <TextBlock Text="Se guarda un MP4 compatible, con el filtro aplicado y sin límite de peso. La captura empieza al pulsar; el archivo se prepara en segundo plano. Del juego conserva el tamaño actual de la novela, con el filtro. Usa 60 FPS para escenas con movimiento. Los MP4 se organizan en Archivos VN All in One / Clips / Nombre del juego. Usa Renombrar MP4 para cambiar un nombre guardado." Style="{StaticResource Help}"/>
  </StackPanel></TabItem>
  <TabItem Header="05   Capturas"><StackPanel><TextBlock Text="Guarda el instante" Style="{StaticResource Title}"/><TextBlock Text="Toma una imagen PNG de la novela con tu nitidez y color actuales. La captura mantiene la proporción del juego y no incluye los controles de Nitidez." Style="{StaticResource Help}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Una tecla, una imagen" Style="{StaticResource Subhead}"/><TextBlock Text="Conecta el juego en Inicio y espera a Captura lista. Al jugar, pulsa la tecla de captura; el PNG se guarda después de tomar la imagen, sin interrumpir la partida. También puedes usar este botón." Style="{StaticResource Help}"/><WrapPanel><Button x:Name="SceneScreenshot" Content="Tomar captura PNG" Margin="0,0,10,10"/><Button x:Name="ScreenshotFolder" Content="Abrir carpeta" Margin="0,0,0,10"/></WrapPanel><TextBlock x:Name="ScreenshotKeys" TextWrapping="Wrap" Foreground="#E1BED4" Margin="0,16,0,0"/><TextBlock x:Name="ScreenshotStatus" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#D8C1D2"/></StackPanel></Border><TextBlock Text="Los PNG se organizan en Archivos VN All in One / Capturas / Nombre del juego, con nombres como Wagamama_01.png y Wagamama_02.png. Las imágenes conservan su resolución original. El cursor de Windows no se incluye; un cursor dibujado por el propio juego puede aparecer." Style="{StaticResource Help}"/></StackPanel></TabItem>
  <TabItem Header="06   Teclas"><StackPanel><TextBlock Text="Tus propios atajos" Style="{StaticResource Title}"/><TextBlock Text="Haz clic en un campo y pulsa la tecla o combinación que quieras, por ejemplo Ctrl + F6. Puedes usar Ctrl, Alt o Shift. Las combinaciones repetidas se rechazan." Style="{StaticResource Help}"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Mientras estás en el juego" Style="{StaticResource Subhead}"/><TextBlock Text="Estas teclas actúan solo cuando la novela seleccionada está al frente. El juego conserva el foco; la tecla asignada queda reservada para Nitidez." Style="{StaticResource Help}"/>
    <TextBlock Text="Conservar audio reciente" Style="{StaticResource Label}"/><TextBox x:Name="AudioKey" AutomationProperties.Name="Atajo para capturar audio" Margin="0,0,0,14"/>
    <TextBlock Text="Iniciar clip" Style="{StaticResource Label}"/><TextBox x:Name="VideoStartKey" AutomationProperties.Name="Atajo para iniciar clip" Margin="0,0,0,14"/>
    <TextBlock Text="Terminar clip y guardar" Style="{StaticResource Label}"/><TextBox x:Name="VideoStopKey" AutomationProperties.Name="Atajo para detener clip" Margin="0,0,0,14"/>
    <TextBlock Text="Tomar captura PNG" Style="{StaticResource Label}"/><TextBox x:Name="ScreenshotKey" AutomationProperties.Name="Atajo para captura PNG"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Disponibles en cualquier ventana" Style="{StaticResource Subhead}"/><TextBlock Text="Activar o desactivar el filtro" Style="{StaticResource Label}"/><TextBox x:Name="Key" AutomationProperties.Name="Atajo para alternar el filtro" Margin="0,0,0,14"/><TextBlock Text="Cerrar Nitidez" Style="{StaticResource Label}"/><TextBox x:Name="CloseKey" AutomationProperties.Name="Atajo para cerrar Nitidez"/><TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Foreground="#D8C1D2" Margin="0,12,0,0"/></StackPanel></Border>
   <TextBlock x:Name="ShortcutStatus" Text="Los cambios se guardan al cerrar. Si otra aplicación ocupa un atajo, el panel te lo indicará al volver al juego." Style="{StaticResource Help}"/><Button x:Name="ResetKeys" Content="Restaurar teclas originales" HorizontalAlignment="Left"/>
  </StackPanel></TabItem>
 </TabControl>
 <StackPanel Width="156" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,22,0,0" IsHitTestVisible="False"><Image x:Name="Mascot" Width="112" Height="112" HorizontalAlignment="Left"/><TextBlock Text="Nitidez VN" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,2"/></StackPanel>
 <StackPanel Width="156" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,22"><TextBlock x:Name="EffectState" Text="DESACTIVADO" Foreground="#C2AFBF" FontSize="11" Margin="0,0,0,8"/><Button x:Name="Toggle" Content="+" FontSize="28" Height="48" Padding="0" ToolTip="Activar o desactivar el filtro" AutomationProperties.Name="Activar o desactivar efecto"/><TextBlock Text="El juego conserva el foco" Foreground="#A88C9F" FontSize="10" Margin="0,10,0,0"/></StackPanel></Grid>
